{
  "schema_version": 2,
  "experiment": "capacity",
  "version": "0.1.22",
  "policy_id": "optin-discovery-100k-v1",
  "scope": "New source-bound opt-in discovery qualification with same-workspace persisted-policy increase; Python import-chain operational coverage, not arbitrary-source memory safety/speed/relevance",
  "limits": {
    "seconds": 2400,
    "disk_bytes": 8589934592,
    "rss_bytes": 4294967296,
    "evidence_bytes": 268435456
  },
  "generator": "zero-padded-python-import-chain-v1",
  "configured_request_max_files": 100000,
  "default_discovery_max_files": 50000,
  "maximum_discovery_max_files": 100000,
  "cases": [
    {
      "id": "policy-upgrade-100k",
      "size": 100000,
      "seconds": 900,
      "phases": [
        {
          "name": "default",
          "discovery_env": null,
          "selected": 50000,
          "truncated": true,
          "outcome": "limited",
          "persisted_before": false
        },
        {
          "name": "expanded",
          "discovery_env": "100000",
          "selected": 100000,
          "truncated": false,
          "outcome": "passed",
          "persisted_before": true
        },
        {
          "name": "restart",
          "discovery_env": "100000",
          "selected": 100000,
          "truncated": false,
          "outcome": "passed",
          "persisted_before": true
        }
      ]
    },
    {
      "id": "exact-50k",
      "size": 50000,
      "seconds": 400,
      "phases": [
        {
          "name": "cold",
          "discovery_env": "100000",
          "selected": 50000,
          "truncated": false,
          "outcome": "passed",
          "persisted_before": false
        },
        {
          "name": "restart",
          "discovery_env": "100000",
          "selected": 50000,
          "truncated": false,
          "outcome": "passed",
          "persisted_before": true
        }
      ]
    },
    {
      "id": "overflow-100001",
      "size": 100001,
      "seconds": 700,
      "phases": [
        {
          "name": "cold",
          "discovery_env": "100000",
          "selected": 100000,
          "truncated": true,
          "outcome": "limited",
          "persisted_before": false
        },
        {
          "name": "restart",
          "discovery_env": "100000",
          "selected": 100000,
          "truncated": true,
          "outcome": "limited",
          "persisted_before": true
        }
      ]
    }
  ],
  "pass_rule": "Every predeclared case and7newPIDphases completes exactAST/ref/keyword/body identities/source-bound boundaryhits/imports/outside miss/SQLite/persistedinputbytecontinuity/origin/limits/cleanup; default50k retained, opt-inexact100kfull,100001 clipped100k disclosed",
  "policy": "Source/design frozen before single launch; no replacement/rerun/resume/retune/capwaiver; firstunexpectedoutcome retainsincomplete original andstops laterphases",
  "runtime_target": {
    "runner": "ubuntu-latest",
    "sys_platform": "linux",
    "machine": "x86_64"
  }
}
